{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grid-games-pivot",
  "account_id": "a22fe9411b81705409eb7cdf9be367e3",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "pivot.gridgames.space", "custom_domain": true }],
  "assets": { "binding": "ASSETS", "not_found_handling": "none" },
  "durable_objects": {
    "bindings": [
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "GAME_ROOMS", "class_name": "GameRoom" },
      { "name": "QUOTE_GATE", "class_name": "QuoteGate" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Multiplayer"] },
    { "tag": "v2", "new_sqlite_classes": ["Lobby", "GameRoom"] },
    { "tag": "pivot-v1", "new_sqlite_classes": ["QuoteGate"] },
  ],
  "vars": {
    "ROBINHOOD_RPC_URL": "https://robinhood.drpc.org",
    "ALLOWED_ORIGINS": "https://grid-games-pivot.mathew.workers.dev,https://pivot.gridgames.space",
    "NEXT_PUBLIC_URL": "https://pivot.gridgames.space",
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true },
  },
}
